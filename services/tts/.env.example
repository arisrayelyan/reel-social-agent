PORT=4042
# Chatterbox model: standard (house voice, has cfg/exaggeration), turbo, nano, multilingual
TTS_MODEL=standard
# House narration preset (docs/pipeline-learnings.md §8)
TTS_SEED=42
TTS_CFG=0.3
TTS_EXAGGERATION=0.35
# auto -> cuda > mps > cpu
TTS_DEVICE=auto
# Delivery pace. The house preset measures 182–194 wpm on real beats, so the
# service inserts silence between sentences and time-stretches (pitch kept,
# never below 0.8x) down to the target. 152 = a touch brisker than the 145
# planning rate (Aram's call after listening); reels run ~5% shorter than estimated.
# Set TTS_TARGET_WPM=0 to disable the stretch, TTS_SENTENCE_GAP_SECONDS=0 for
# the old one-chunk-per-beat behaviour. Verify with: pnpm tts:calibrate
TTS_TARGET_WPM=152
TTS_SENTENCE_GAP_SECONDS=0.35
# Optional: reference voice clip (~10s, one clean speaker) locks timbre harder than a seed
TTS_VOICE_REF=
# Optional: point the HuggingFace weight cache somewhere specific (weights are ~3GB, lazily downloaded)
# HF_HOME=
