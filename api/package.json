{
  "name": "@reel-agent/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "node-pg-migrate -m src/database/migrations --migration-filename-format utc up",
    "migrate:down": "node-pg-migrate -m src/database/migrations down",
    "migrate:create": "node-pg-migrate -m src/database/migrations --migration-file-language sql create"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "@fastify/cors": "^11.3.0",
    "@fastify/postgres": "^6.1.0",
    "@fastify/static": "^10.1.3",
    "@google/genai": "^2.20.0",
    "@reel-agent/shared": "workspace:*",
    "axios": "^1.20.0",
    "bullmq": "^6.3.4",
    "dotenv": "^17.2.4",
    "execa": "^10.0.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.16.4",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.14",
    "@types/pg": "^8.15.6",
    "node-pg-migrate": "^9.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
