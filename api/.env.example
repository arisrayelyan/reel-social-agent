# --- server ---
PORT=4041
# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:4040
LOG_LEVEL=info

# --- storage (generated media lives here, relative to repo root or absolute) ---
STORAGE_DIR=../storage
# All LLM prompt templates live here as editable .md files
PROMPTS_DIR=../prompts

# --- postgres (pgvector-enabled) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5439/reel-agent

# --- redis (BullMQ + pub/sub). Container: redis-mq, host port 6378, pass 123456 ---
REDIS_URL=redis://:123456@localhost:6378

# --- ollama (free/local LLM + embeddings) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.6:latest
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b

# --- CLI executors (paid story generation via your existing subscriptions) ---
CLAUDE_CLI_PATH=claude
# Model for the claude CLI (opus = best story quality)
CLAUDE_MODEL=opus
CODEX_CLI_PATH=codex
# Fallback model only — the Generate page picks model + reasoning effort per
# request from shared/src/codexModels.ts (hand-maintained; codex has no
# --list-models). `<model>` or `<model>@<effort>` (minimal|low|medium|high|xhigh)
CODEX_MODEL=gpt-6-astra@high
# Estimated codex pricing, "model-prefix:input/output" per 1M tokens, comma
# separated. Overrides the built-in table in llm/codexPricing.ts (API list
# price; a ChatGPT-subscription login bills $0). e.g. gpt-6-astra:10/50
CODEX_PRICE_PER_MTOK_MAP=
CURSOR_CLI_PATH=cursor-agent
# Fallback model only — the Generate page picks model + effort per request from
# shared/src/cursorModels.ts (refresh with `pnpm cursor:models`)
CURSOR_MODEL=claude-opus-5-thinking-high
# Estimated cursor pricing, "id-prefix:input/output" per 1M tokens, comma
# separated. Overrides the built-in family table in llm/cursorPricing.ts;
# leave empty to use it. e.g. claude-opus:5/25,gemini:0.3/2.5
CURSOR_PRICE_PER_MTOK_MAP=

# --- Google Nano Banana (Gemini image generation) — get key at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Estimated $ per generated image. Set it to match GEMINI_IMAGE_MODEL:
#   gemini-2.5-flash-image      0.039   768x1344 (ignores GEMINI_IMAGE_SIZE)
#   gemini-3.1-flash-image  2K  0.101   1536x2752
#   gemini-3-pro-image      2K  0.134   1536x2752
#   gemini-3.1-flash-lite-image 0.0336  1K only
# Verified against Google's pricing page 3 Sep 2026; the measured 1680 image
# tokens for 3.1-flash at 2K match their published figure exactly.
GEMINI_IMAGE_COST_USD=0.039
# 1K | 2K | 4K, or empty to send nothing.
#
# VERIFIED 3 Sep 2026: gemini-2.5-flash-image ACCEPTS this and IGNORES it —
# 1K and 2K both return 768x1344 at identical token cost. Only the gemini-3
# image models honour it. This matters because everything upstream is
# 768x1344 while the render target is 1080x1920, so a still is already being
# upscaled 1.4x before a shot's camera move zooms into it. At 1536x2752 the
# same move DOWN-scales instead, and measured high-frequency detail is 2-3.7x
# higher. Empty by default: 2K is real quality but 2.6x the price per still,
# and a video now buys one still per shot.
GEMINI_IMAGE_SIZE=

# --- fal.ai (image-to-video) — get key at https://fal.ai/dashboard/keys ---
FAL_KEY=
FAL_VIDEO_MODEL=minimax/h3-max/image-to-video
# Last-resort $ per second when a model is in neither the map below nor the
# verified table in api/src/clients/falModels.ts. The table is authoritative
# and per-resolution; this only catches an endpoint nobody has checked.
FAL_COST_PER_SECOND_USD=0.08
# Per-model $/s, "model:price,model:price". Overrides the scalar above and the
# verified table in api/src/clients/falModels.ts, so tier costs stay honest.
FAL_COST_PER_SECOND_USD_MAP=
# 480P or 768P on the current endpoint. Part of the clip content hash, so
# changing it produces a new take rather than silently reusing the old one.
FAL_VIDEO_RESOLUTION=768P
# The endpoint REQUIRES this and rewrites the motion prompt either way.
# balanced ~1s, quality ~30s for a richer rewrite (same price). Under
# "balanced" the rewrites came back "Static Shot ... small amplitude at slow
# speed" on beats that asked for real motion, so quality is the default. The
# rewrite is recorded as expanded_prompt in generation_runs, and clips.ts
# flags flattened rewrites as expansion_flags — read them before tuning rules.
FAL_PROMPT_EXPANSION_MODE=quality
# How many beats may get a generated video clip.
#
# EMPTY = no cap: every beat gets one and the reel stays generated video
# throughout, which is the look the channel has always had. That is now
# CHEAPER than the old pipeline rather than dearer: each beat's shots are
# different windows of its clip, so three 2.7s shots need a ~6s clip instead
# of the padded 9-10s one whole-beat requests bought and merge trimmed away.
#
# A NUMBER caps it, and the uncapped beats cut from their stills with an
# ffmpeg camera move instead — cheaper again, but it turns the reel into a
# photo montage, so treat it as a cost lever and look at the result. Clips go
# to the hook first, then the turn or reveal money shot. 0 = stills only.
#
# A producer promoting specific beats at render review
# (POST /videos/:id/upgrade-clips) bypasses this either way.
FAL_MAX_CLIPS_PER_VIDEO=
# Cheap first pass. EMPTY = tiering off (every beat renders premium, as before).
# Pricing is not in the openapi document, so confirm $/s on the model's
# playground page before adopting one — a 200 proves nothing about unit cost.
# Check any candidate first:  pnpm fal:schema <endpoint-id>
FAL_VIDEO_MODEL_DRAFT=
FAL_VIDEO_RESOLUTION_DRAFT=480P
# Deterministic loopable final frame: one extra Gemini edit of the kicker
# keyframe, driven through the endpoint's end_image_url. Set false to skip.
LOOPABLE_KICKER=true

# --- Firecrawl (generate-from-URL scraping) — get key (fc-…) at https://www.firecrawl.dev → dashboard → API Keys ---
FIRECRAWL_API_KEY=
# Pages linked from the source article to also scrape (each page = 1 credit).
# 0 = the given URL's main content only (default since 4 Sep 2026).
FIRECRAWL_MAX_LINKED_PAGES=0
# Estimated $ per scraped page (1 credit ≈ $0.005 on the hobby plan)
FIRECRAWL_COST_PER_PAGE_USD=0.005
# Photos from the page's main content, downloaded and described by the story
# provider (one extra call at that provider's price); descriptions reach the
# story prompt as PHOTO NOTES. 0 disables photos entirely.
FIRECRAWL_MAX_SOURCE_IMAGES=4
# false skips the vision pass (photos still download and show in the UI).
SOURCE_IMAGE_ANALYSIS=true

# --- internal services ---
TTS_URL=http://localhost:4042
CAPTIONS_URL=http://localhost:4043
# Narration delivery pace, sent per beat and part of the audio content hash.
# 152 = slightly brisker than the 145 planning rate (estimates run ~5% long). 0 disables the stretch;
# gap 0 = one chunk per beat. Verify for free with: pnpm tts:calibrate
TTS_TARGET_WPM=152
TTS_SENTENCE_GAP_SECONDS=0.35
# Small mono "AI RECONSTRUCTION" tag under the evidence stamp on the setup
# beat. TikTok requires AIGC that shows realistic scenes or people to be
# labelled; this keeps the reel honest even before the platform toggle.
RECONSTRUCTION_TAG=true

# --- TikTok (Login Kit + Content Posting inbox upload) — https://developers.tiktok.com/apps ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:4041/api/tiktok/callback

# --- Telegram notifier (see README: @BotFather token, @userinfobot chat id, press Start) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
